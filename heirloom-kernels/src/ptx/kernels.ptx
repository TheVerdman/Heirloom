    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r5, %r2, %r3, %r1;
    setp.ge.u32 %p1, %r5, %r4;
    @%p1 bra DONE_BF16_TO_F32;
    mul.wide.u32 %rd3, %r5, 2;
    mul.wide.u32 %rd4, %r5, 4;
    add.s64 %rd5, %rd1, %rd3;
    add.s64 %rd6, %rd2, %rd4;
    ld.global.u16 %r6, [%rd5];
    shl.b32 %r7, %r6, 16;
    st.global.u32 [%rd6], %r7;
DONE_BF16_TO_F32:
    ret;
}

.visible .entry heirloom_f32_bf16_roundtrip_f32(
    .param .u64 input,
