    add.s64 %rd4, %rd1, %rd3;
    add.s64 %rd5, %rd2, %rd3;
    ld.global.u32 %r6, [%rd4];
    shr.u32 %r7, %r6, 16;
    and.b32 %r8, %r7, 1;
    add.u32 %r9, %r8, 32767;
    add.u32 %r10, %r6, %r9;
    shr.u32 %r11, %r10, 16;
    shl.b32 %r12, %r11, 16;
    st.global.u32 [%rd5], %r12;
