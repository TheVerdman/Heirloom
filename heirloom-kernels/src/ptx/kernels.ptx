    ret;
}

.visible .entry heirloom_bias_add_f32(
    .param .u64 matrix,
    .param .u64 bias,
    .param .u64 output,
    .param .u32 rows,
    .param .u32 cols,
    .param .u32 total
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<8>;
    .reg .b64 %rd<12>;
    .reg .f32 %f<4>;

    ld.param.u64 %rd1, [matrix];
    ld.param.u64 %rd2, [bias];
    ld.param.u64 %rd3, [output];
    ld.param.u32 %r4, [rows];
    ld.param.u32 %r5, [cols];
    ld.param.u32 %r6, [total];
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r7, %r2, %r3, %r1;
    setp.ge.u32 %p1, %r7, %r6;
    @%p1 bra DONE_BIAS_ADD;
    rem.u32 %r4, %r7, %r5;
    mul.wide.u32 %rd4, %r7, 4;
    add.s64 %rd5, %rd1, %rd4;
    add.s64 %rd6, %rd3, %rd4;
    mul.wide.u32 %rd7, %r4, 4;
    add.s64 %rd8, %rd2, %rd7;
    ld.global.f32 %f1, [%rd5];
    ld.global.f32 %f2, [%rd8];
    add.f32 %f3, %f1, %f2;
    st.global.f32 [%rd6], %f3;
DONE_BIAS_ADD:
    ret;
}

.visible .entry heirloom_bias_add_backward_bias_f32(
    .param .u64 grad_output,
    .param .u64 output,
    .param .u32 rows,
    .param .u32 cols,
    .param .u32 total
)
{
    .reg .pred %p<3>;
    .reg .b32 %r<9>;
    .reg .b64 %rd<10>;
    .reg .f32 %f<3>;

    ld.param.u64 %rd1, [grad_output];
    ld.param.u64 %rd2, [output];
    ld.param.u32 %r4, [rows];
    ld.param.u32 %r5, [cols];
    ld.param.u32 %r6, [total];
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r7, %r2, %r3, %r1;
    setp.ge.u32 %p1, %r7, %r6;
    @%p1 bra DONE_BIAS_BACKWARD;
    mov.f32 %f1, 0f00000000;
    mov.u32 %r8, 0;
BIAS_BACKWARD_LOOP:
    setp.ge.u32 %p2, %r8, %r4;
    @%p2 bra BIAS_BACKWARD_WRITE;
    mad.lo.s32 %r6, %r8, %r5, %r7;
    mul.wide.u32 %rd3, %r6, 4;
    add.s64 %rd4, %rd1, %rd3;
    ld.global.f32 %f2, [%rd4];
    add.f32 %f1, %f1, %f2;
    add.u32 %r8, %r8, 1;
    bra BIAS_BACKWARD_LOOP;
BIAS_BACKWARD_WRITE:
    mul.wide.u32 %rd5, %r7, 4;
    add.s64 %rd6, %rd2, %rd5;
    st.global.f32 [%rd6], %f1;
DONE_BIAS_BACKWARD:
    ret;
}

.visible .entry heirloom_sgd_update_f32(
