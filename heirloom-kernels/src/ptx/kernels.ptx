.visible .entry heirloom_f32_to_bf16(
    .param .u64 input,
    .param .u64 output,
    .param .u32 n
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<12>;
    .reg .b64 %rd<8>;

    ld.param.u64 %rd1, [input];
    ld.param.u64 %rd2, [output];
    ld.param.u32 %r4, [n];
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r5, %r2, %r3, %r1;
    setp.ge.u32 %p1, %r5, %r4;
    @%p1 bra DONE_F32_TO_BF16;
    mul.wide.u32 %rd3, %r5, 4;
    mul.wide.u32 %rd4, %r5, 2;
    add.s64 %rd5, %rd1, %rd3;
    add.s64 %rd6, %rd2, %rd4;
    ld.global.u32 %r6, [%rd5];
    shr.u32 %r7, %r6, 16;
    and.b32 %r8, %r7, 1;
    add.u32 %r9, %r8, 32767;
    add.u32 %r10, %r6, %r9;
    shr.u32 %r11, %r10, 16;
    st.global.u16 [%rd6], %r11;
DONE_F32_TO_BF16:
    ret;
}

.visible .entry heirloom_bf16_to_f32(
    .param .u64 input,
    .param .u64 output,
    .param .u32 n
)
{
    .reg .pred %p<2>;
