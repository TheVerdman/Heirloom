{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heirloom.local/schemas/padawan_artifact_bundle_v0.schema.json",
  "title": "Heirloom Padawan Artifact Bundle v0",
  "type": "object",
  "required": [
    "format",
    "version",
    "episode_id",
    "artifacts",
    "restricted_audit"
  ],
  "properties": {
    "format": { "const": "heirloom.padawan_artifact_bundle" },
    "version": { "const": 0 },
    "episode_id": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "ref", "media_type", "sha256", "bytes"],
        "properties": {
          "name": { "type": "string" },
          "ref": { "type": "string" },
          "media_type": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "restricted_audit": {
      "type": "object",
      "required": [
        "verifier_pack_id",
        "verifier_pack_hash",
        "public_verifier_hash",
        "hidden_verifier_hash",
        "hidden_case_ids_hmac",
        "artifact_hashes",
        "result_digest",
        "restricted_bundle_ref"
      ],
      "properties": {
        "verifier_pack_id": { "type": "string" },
        "verifier_pack_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "public_verifier_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "hidden_verifier_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "hidden_case_ids_hmac": {
          "type": "array",
          "items": { "type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$" }
        },
        "artifact_hashes": { "type": "object" },
        "result_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "restricted_bundle_ref": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
